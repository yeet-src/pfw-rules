// @description Resets requests for Confluence's Remote API, SOAP and XML-RPC.
// @patches Confluence Data Center before 9.2.28, Remote API on
// @cve CVE-2026-90436
// @severity critical
// @tags confluence, java, rce
// @knob port    The port to guard.
// @knob xmlrpc  1 lets /rpc/xmlrpc through; SOAP is still reset.
//
// Affects Confluence Data Center 1.x to 9.x; 10.x removed the feature.
//
// Apache Axis 1.x is end-of-life and has an unauthenticated unsafe-reflection
// bug; Confluence reaches it when "Remote API (XML-RPC & SOAP)" is enabled.
// The exploitation seen in the wild was a POST to
// /plugins/servlet/soap-axis1/confluenceservice-v2, with the older
// /rpc/soap-axis1/ mapping leading to the same code. Atlassian's workaround
// is to switch the Remote API off, and its advisory names Axis as the
// library behind both the SOAP and the XML-RPC API, so this closes both at
// the network. Scripts, automations and add-ons that use the Remote API stop
// working while it is applied.
//
// It does not cover N-able N-central, which embeds the same library behind
// its Legacy API on another path.
//
//   axis1_soap    the segment `soap-axis1`
//   axis1_xmlrpc  a connection that has carried both `/rpc` and `xmlrpc`
//
// Checked against Tomcat 9, which Confluence runs on: it serves the same
// resource for /rpc;a=b/xmlrpc, //, /./, /x/../ and for any letter, digit or
// hyphen percent-encoded (soap%2daxis1, xmlrp%63), so the segments are matched
// apart, each character in either form, and remembered across the connection
// rather than looked for as one path. The cost: a request that only mentions
// `soap-axis1`, or both of the other two, in a Referer or in the text of a
// page being saved, is reset too.
//
// Plaintext HTTP/1 only: put it behind the TLS terminator. It reads nothing
// on an AJP port or over HTTP/2.
nocase;
// Reassembly follows port 8090 only. With the `port` knob set to anything
// else, packets are judged one at a time and a signature split across two is
// missed: to guard another port properly, change the number here as well.
reassemble 8090;
regex soap = "(s|%73)(o|%6f)(a|%61)(p|%70)(-|%2d)(a|%61)(x|%78)(i|%69)(s|%73)(1|%31)";
regex rpc = "/(r|%72)(p|%70)(c|%63)";
regex xmlrpc = "(x|%78)(m|%6d)(l|%6c)(r|%72)(p|%70)(c|%63)";
filter {
  if (proto != 6) decide pass;
  if (dport != knob("port") ?? 8090) decide pass;
  let allow_xmlrpc = knob("xmlrpc") ?? 0;
  mask m = scan(payload, 4096);
  if (any(m, soap)) decide rst("axis1_soap", 0);
  // flow.r0 remembers each segment once seen: the match mask is only this
  // window, and Tomcat takes kilobytes of path parameter between the two.
  if (any(m, rpc)) flow.r0 = flow.r0 | 1;
  if (any(m, xmlrpc)) flow.r0 = flow.r0 | 2;
  if (flow.r0 == 3) {
    if (allow_xmlrpc == 0) decide rst("axis1_xmlrpc", 0);
  }
  decide pass;
}

// @description Resets Grafana's login_error cookie, and tests that reuse saved secrets.
// @patches Grafana before 13.3.2, 13.2.7, 13.1.11, 13.0.14 and 12.4.16
// @cve CVE-2026-107561, CVE-2026-88960
// @tags http, grafana, go, information-disclosure
// @knob port        The port to guard.
// @knob block_test  0 counts tests of saved contact points instead.
//
// Grafana's 13.3.2 release notes name CVE-2026-107561 and CVE-2026-88960
// and say nothing else; no advisory or severity is published yet, and which
// ID is which bug is not said. The 13.3.1 -> 13.3.2 diff fixes two things that
// a request can reach, and this policy covers both, so it holds whichever way
// the IDs fall:
//
//   grafana_login_error    pkg/api/login.go. GET /login took the login_error
//                          cookie, decrypted it with the instance's general
//                          secrets service and showed the plaintext on the
//                          page: anyone holding a ciphertext the instance made
//                          (a backup, a copied grafana.db) could have it
//                          decrypted without logging in. Any request carrying
//                          the cookie is reset.
//
//   grafana_receiver_test  pkg/services/ngalert/notifier/receiver_testing_svc.go.
//                          Testing a SAVED contact point reused its stored
//                          secrets by field name even when the request changed
//                          the integration's type or schema version, and
//                          echoed notifier errors that could hold them. That is
//                          POST .../receivers/<uid>/test with a real uid; a new
//                          contact point is tested as receivers/-/test, never
//                          reached the patched code, and is let through.
//
// Checked against Grafana 13.3.1 itself (Go 1.27 net/http):
//
//   The cookie. Go reads a cookie by exact, case-sensitive name after any run
//   of spaces or tabs, after ":" or ";" (",": no), with spaces or tabs before
//   the "=", in a second Cookie header, in a folded header line and with bare
//   line feeds. So the name is matched after any of ": ;\t" and before
//   optional blanks and "=", in any header, and its value is not looked at.
//
//   The route. Grafana routes percent-encoded paths: %74est, an encoded uid,
//   %2E in the group and %2F for the slash before "test" all reach the test
//   handler, while //, /./, /x/../, a trailing slash, a #fragment (Go keeps it
//   in the path), upper-case TEST and a lower-case method do not. So "receivers", "test" and the slashes match
//   in either form, the uid segment is anything but "-" or "%2D", and the
//   route must end the path: a space before HTTP/1, or "?". The method and
//   the group before it are not matched, so neither a long absolute-form host
//   nor an encoded group stretches the match.
//
// The cost. After a failed OAuth or SSO login Grafana sets login_error for 60
// seconds; for those 60 seconds that browser's requests are reset instead of
// showing the error. "Test" on a saved contact point stops working; set
// block_test to 0 to count those requests and let them through.
//
// Not covered: a uid longer than about 150 bytes, which is past what Grafana
// generates, laid across a reassembly window move. Plaintext HTTP/1 only:
// put pfw behind whatever terminates TLS for Grafana. CVE-2026-88943 in the
// same releases is the dashboard snapshot delete check, which needs a logged-in
// user and is not something the wire shows; upgrade for it.
//
// Reassembly is tied to port 3000. With the port knob set to anything else,
// packets are judged one at a time and a cookie split across two is missed: to
// guard another port properly, change the number here as well.
reassemble 3000;
regex login_error = "[;: \t]login_error[ \t]*=";
regex receiver_test = "(/|%2[fF])(r|%72)(e|%65)(c|%63)(e|%65)(i|%69)(v|%76)(e|%65)(r|%72)(s|%73)(/|%2[fF])(([^/ ?%]|%[0-9a-fA-F][0-9a-fA-F])([^/ ?%]|%[0-9a-fA-F][0-9a-fA-F])+|[^-/ ?%]|%([013-9a-fA-F][0-9a-fA-F]|2[0-9a-cA-CeEfF]))(/|%2[fF])(t|%74)(e|%65)(s|%73)(t|%74)( HTTP/1\.|\?)";
filter {
  if (proto != 6) decide pass;
  if (dport != knob("port") ?? 3000) decide pass;
  mask m = scan(payload, 4096);
  if (any(m, login_error)) decide rst("grafana_login_error", 0);
  if (any(m, receiver_test)) {
    if (knob("block_test") ?? 1 == 1) decide rst("grafana_receiver_test", 0);
    count("grafana_receiver_test_seen");
  }
  decide pass;
}
